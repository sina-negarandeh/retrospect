# Copy to .env and fill in the required values:
#
#   cp .env.example .env
#
# Two consumers read this file. Docker Compose reads it to substitute ${HF_TOKEN}
# in docker-compose.yml, and the application reads it through pydantic-settings
# (app/config.py). Every key below maps to a field on Settings; anything left
# commented out falls back to the default shown.
#
# Note that docker-compose.yml sets OLLAMA_BASE_URL, QDRANT_URL and
# MLFLOW_TRACKING_URI directly on the api container. Real environment variables
# take precedence over this file, so those three only take effect when running
# the app outside Docker.

# --- Required ---------------------------------------------------------------

# Hugging Face token, used at startup to download the ms-marco-MiniLM-L-6-v2
# Cross-Encoder for re-ranking and the tokenizer used for chunking.
HF_TOKEN=

# Bearer token guarding the /api/v1/admin endpoints, which can trigger
# ingestion and wipe the Qdrant collection. Set a long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# --- Application ------------------------------------------------------------

# APP_NAME=Retrospect
# APP_VERSION=0.1.0
# API_PREFIX=/api/v1
# LOG_LEVEL=INFO
# DEBUG=false

# Origins allowed to make cross-origin requests, as a JSON array. A bare
# comma-separated list is rejected at startup. The default of * is intended for
# development only; restrict it before exposing the service.
# CORS_ALLOWED_ORIGINS=["https://app.example.com","https://admin.example.com"]

# --- Ollama (local deployment) ----------------------------------------------

# Use http://host.docker.internal:11434 from inside a container, or
# http://localhost:11434 when running the app directly on the host.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=gemma4:26b-mlx
# OLLAMA_EMBEDDING_MODEL=embeddinggemma:300m

# --- Qdrant -----------------------------------------------------------------

# Use http://qdrant:6333 on the Compose network, or http://localhost:6333 from
# the host.
# QDRANT_URL=http://qdrant:6333
# QDRANT_COLLECTION_NAME=retrospect_docs

# --- Document processing ----------------------------------------------------

# CHUNK_SIZE=512
# CHUNK_OVERLAP=64
# TOKENIZER_MODEL=google/gemma-4-26B-A4B-it
# VECTOR_STORE_BATCH_SIZE=20
# QDRANT_SCROLL_BATCH_SIZE=100

# --- Retrieval --------------------------------------------------------------

# Candidate pool fetched from Qdrant per retrieval pass.
# RETRIEVAL_TOP_K=20
# Wider pool used by the final broadened pass.
# RETRIEVAL_BROAD_TOP_K=40
# Re-ranked documents handed to the generation model.
# RETRIEVAL_FINAL_K=5
# Passes through the self-correcting retrieval loop. Set to 1 to disable it.
# RETRIEVAL_MAX_ATTEMPTS=3
# Minimum Cross-Encoder score for a pass to count as relevant. ms-marco-MiniLM
# emits logits roughly in the range -11 to +11, where above 0 indicates relevance.
# RETRIEVAL_RELEVANCE_THRESHOLD=0.0

# --- MLflow -----------------------------------------------------------------

# Use http://mlflow:5000 on the Compose network, or http://localhost:5002 from
# the host, which is the port docker-compose.yml publishes.
# MLFLOW_TRACKING_URI=http://mlflow:5000
# MLFLOW_EXPERIMENT_NAME=retrospect
